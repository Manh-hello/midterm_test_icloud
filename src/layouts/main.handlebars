<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <title>Quản lý Sách</title>
  <style>
    body{font-family:Arial;max-width:800px;margin:30px auto;padding:0 15px}
    table{border-collapse:collapse;width:100%}
    th,td{border:1px solid #ccc;padding:8px;text-align:left}
    input{padding:6px;margin:4px}
    .msg{padding:10px;background:#eef;margin:10px 0}
    footer{margin-top:40px;padding-top:10px;border-top:2px solid #333}
  </style>
</head>
<body>
  {{{body}}}
  <footer>
    <p><b>Họ tên:</b> {{footer.hoTen}} | <b>MSSV:</b> {{footer.mssv}} | <b>VAT áp dụng:</b> {{footer.vat}}%</p>
  </footer>
</body>
</html>